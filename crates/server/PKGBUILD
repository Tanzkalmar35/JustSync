# Maintainer: Fabian Holler <fabianholler@protonmail.com>
pkgname=justsync-server
pkgver=0.1.0
pkgrel=1
epoch=
pkgdesc="The server daemon for the JustSync project"
arch=('x86_64')
url="https://github.com/Tanzkalmar35/JustSync"
license=('AGPL-3.0')
groups=()
depends=()
makedepends=('cargo')
checkdepends=()
optdepends=()
provides=()
conflicts=()
replaces=()
backup=()
options=('!lto')
install=
changelog=
source=("$url/archive/refs/tags/v$pkgver.tar.gz")
noextract=()
sha256sums=('SKIP')
validpgpkeys=()
_dirname="JustSync-$pkgver"

build() {
	cd "$_dirname"
	cargo build --release --locked -p just_sync_server
}

package() {
	cd "$_dirname"
	install -Dm755 "target/release/just_sync_server" "$pkgdir/usr/bin/just_sync_server"
}

